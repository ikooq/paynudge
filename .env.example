# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox app credentials: developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# AI: set ONE of these keys. Groq is the default and has a free plan (no card).
# Groq key: console.groq.com > API Keys > Create API Key
GROQ_API_KEY=
# Optional alternative: Google Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=

# Shown on invoices and used to sign reminders
BUSINESS_NAME=Studio Nord
# Optional. If set, it must be the email of the sandbox business account that owns the app.
BUSINESS_EMAIL=
DEFAULT_CURRENCY=USD

# Optional
# AI_PROVIDER=groq                 # groq | gemini | openai (any OpenAI-compatible API)
# GROQ_MODEL=openai/gpt-oss-120b         # reasoning model, strict JSON schema output
# GROQ_VISION_MODEL=qwen/qwen3.8-27b     # only transcribes chat screenshots
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b # tried once if the main model hits its quota
# AI_REASONING_EFFORT=medium
# GEMINI_MODEL=gemini-2.5-flash
# AI_BASE_URL= AI_API_KEY= AI_MODEL=  # for AI_PROVIDER=openai
# PORT=3000
# DEMO_MODE=true        # run with in-memory PayPal and canned AI even if keys are set
# AI_RATE_LIMIT=40      # AI requests per IP per 10 minutes
